{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage A evaluation report",
  "type": "object",
  "required": [
    "schema_version",
    "overall",
    "scenarios",
    "code_version",
    "input_hash",
    "generated_at_utc",
    "gates",
    "environment"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "overall": {"enum": ["PASS", "FAIL"]},
    "scenarios": {"type": "integer", "minimum": 1},
    "code_version": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "gates": {
      "type": "object",
      "minProperties": 15,
      "additionalProperties": {
        "type": "object",
        "required": ["executed", "checks", "failures", "source", "passed"],
        "properties": {
          "executed": {"type": "boolean"},
          "checks": {"type": "integer", "minimum": 0},
          "failures": {"type": "integer", "minimum": 0},
          "source": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "required": ["python_version", "cpu_model", "memory_bytes"],
      "properties": {
        "python_version": {"type": "string"},
        "cpu_model": {"type": "string"},
        "memory_bytes": {"type": "integer"}
      }
    }
  },
  "additionalProperties": false
}
