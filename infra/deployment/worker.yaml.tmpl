apiVersion: apps/v1
kind: Deployment
metadata:
  name: pma-worker
  labels: {app: pma-worker}
spec:
  replicas: 1
  selector:
    matchLabels: {app: pma-worker}
  template:
    metadata:
      labels: {app: pma-worker}
    spec:
      securityContext:
        runAsNonRoot: true
      terminationGracePeriodSeconds: 30
      containers:
        - name: worker
          image: @@WORKER_IMAGE@@
          envFrom:
            - configMapRef: {name: pma-config}
            - secretRef: {name: pma-secrets}
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {cpu: 1000m, memory: 1Gi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
