# Local development configuration names. Never commit real secrets.

# Optional host port overrides for compose services (defaults: 5432/6379/9000/9001)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

APP_ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL canonical store
DATABASE_URL=postgresql+asyncpg://personal_pm:local_only_password@localhost:5432/personal_pm
DATABASE_URL_SYNC=postgresql+psycopg://personal_pm:local_only_password@localhost:5432/personal_pm

# Redis queue/cache/lock/rate-limit only (never canonical state)
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage for source artifacts
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=personal-pm-local
S3_ACCESS_KEY_ID=personal_pm
S3_SECRET_ACCESS_KEY=local_only_password

# Google Calendar OAuth (values supplied out of band)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# LLM provider (values supplied out of band)
LLM_PROVIDER_API_KEY=

# Application-level encryption key for token vault (generate per environment)
TOKEN_VAULT_KEY=
